<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:importantForAccessibility="no"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/app_name"
                    android:textColor="@color/fg"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tagline"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Section"
            android:text="@string/section_setup" />

        <LinearLayout style="@style/Card">

            <TextView
                android:id="@+id/keyTitle"
                style="@style/CardTitle"
                android:text="@string/key_title" />

            <TextView
                style="@style/CardText"
                android:text="@string/key_text" />

            <EditText
                android:id="@+id/apiKey"
                style="@style/Field"
                android:hint="@string/key_hint"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:singleLine="true" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                android:id="@+id/micTitle"
                style="@style/CardTitle"
                android:text="@string/mic_title" />

            <TextView
                style="@style/CardText"
                android:text="@string/mic_text" />

            <Button
                android:id="@+id/micButton"
                style="@style/Action"
                android:text="@string/mic_allow" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                android:id="@+id/a11yTitle"
                style="@style/CardTitle"
                android:text="@string/a11y_title" />

            <TextView
                style="@style/CardText"
                android:text="@string/a11y_text" />

            <Button
                android:id="@+id/a11yButton"
                style="@style/Action"
                android:text="@string/a11y_open" />

            <TextView
                style="@style/CardText"
                android:layout_marginTop="8dp"
                android:text="@string/a11y_restricted"
                android:textColor="@color/faint"
                android:textSize="13sp" />

            <Button
                android:id="@+id/appInfoButton"
                style="@style/Action"
                android:text="@string/app_info" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/try_title" />

            <TextView
                style="@style/CardText"
                android:text="@string/try_text" />

            <EditText
                style="@style/Field"
                android:hint="@string/try_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences" />
        </LinearLayout>

        <TextView
            style="@style/Section"
            android:text="@string/section_recognition" />

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/sync_title" />

            <TextView
                android:id="@+id/syncStatus"
                style="@style/CardText"
                android:text="@string/sync_text" />

            <Button
                android:id="@+id/syncButton"
                style="@style/Action"
                android:text="@string/sync_sign_in" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/context_title" />

            <TextView
                style="@style/CardText"
                android:text="@string/context_text" />

            <EditText
                android:id="@+id/prompt"
                style="@style/Field"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences" />

            <TextView
                style="@style/CardTitle"
                android:layout_marginTop="16dp"
                android:text="@string/terms_title" />

            <TextView
                style="@style/CardText"
                android:text="@string/terms_text" />

            <EditText
                android:id="@+id/keywords"
                style="@style/Field"
                android:importantForAutofill="no"
                android:inputType="textMultiLine" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <Switch
                android:id="@+id/formatText"
                style="@style/Toggle"
                android:text="@string/format_text" />

            <Switch
                android:id="@+id/stopPhrase"
                style="@style/Toggle"
                android:text="@string/stop_phrase" />

            <Switch
                android:id="@+id/showCost"
                style="@style/Toggle"
                android:text="@string/show_cost" />
        </LinearLayout>

        <TextView
            android:id="@+id/version"
            style="@style/CardText"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textColor="@color/faint"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
