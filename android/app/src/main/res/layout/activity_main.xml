<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:importantForAccessibility="no"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/app_name"
                    android:textColor="@color/fg"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tagline"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Shown while there is an update to install (Updater.kt). -->
        <LinearLayout
            android:id="@+id/updateCard"
            style="@style/Card"
            android:layout_marginTop="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/updateTitle"
                style="@style/CardTitle" />

            <TextView
                android:id="@+id/updateText"
                style="@style/CardText" />

            <ProgressBar
                android:id="@+id/updateProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="100" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/updateButton"
                    style="@style/Action" />

                <Button
                    android:id="@+id/whatsNewButton"
                    style="@style/Action"
                    android:layout_marginStart="12dp"
                    android:text="@string/update_whats_new" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/Card"
            android:layout_marginTop="20dp">

            <TextView
                style="@style/CardTitle"
                android:text="@string/history_title" />

            <TextView
                style="@style/CardText"
                android:text="@string/history_text" />

            <Button
                android:id="@+id/historyButton"
                style="@style/Action"
                android:text="@string/history_open" />
        </LinearLayout>

        <TextView
            style="@style/Section"
            android:text="@string/section_setup" />

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/provider_title" />

            <TextView
                style="@style/CardText"
                android:text="@string/provider_text" />

            <RadioGroup
                android:id="@+id/provider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/providerOpenai"
                    style="@style/Toggle"
                    android:text="@string/provider_openai" />

                <RadioButton
                    android:id="@+id/providerGemini"
                    style="@style/Toggle"
                    android:text="@string/provider_gemini" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                android:id="@+id/keyTitle"
                style="@style/CardTitle" />

            <TextView
                android:id="@+id/keyText"
                style="@style/CardText" />

            <EditText
                android:id="@+id/apiKey"
                style="@style/Field"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:singleLine="true" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                android:id="@+id/micTitle"
                style="@style/CardTitle"
                android:text="@string/mic_title" />

            <TextView
                style="@style/CardText"
                android:text="@string/mic_text" />

            <Button
                android:id="@+id/micButton"
                style="@style/Action"
                android:text="@string/mic_allow" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                android:id="@+id/a11yTitle"
                style="@style/CardTitle"
                android:text="@string/a11y_title" />

            <TextView
                style="@style/CardText"
                android:text="@string/a11y_text" />

            <Button
                android:id="@+id/a11yButton"
                style="@style/Action"
                android:text="@string/a11y_open" />

            <TextView
                style="@style/CardText"
                android:layout_marginTop="8dp"
                android:text="@string/a11y_restricted"
                android:textColor="@color/faint"
                android:textSize="13sp" />

            <Button
                android:id="@+id/appInfoButton"
                style="@style/Action"
                android:text="@string/app_info" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/try_title" />

            <TextView
                style="@style/CardText"
                android:text="@string/try_text" />

            <EditText
                style="@style/Field"
                android:hint="@string/try_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences" />
        </LinearLayout>

        <TextView
            style="@style/Section"
            android:text="@string/section_recognition" />

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/sync_title" />

            <TextView
                android:id="@+id/syncStatus"
                style="@style/CardText"
                android:text="@string/sync_text" />

            <Button
                android:id="@+id/syncButton"
                style="@style/Action"
                android:text="@string/sync_sign_in" />

            <Switch
                android:id="@+id/syncKeys"
                style="@style/Toggle"
                android:text="@string/sync_keys" />

            <TextView
                style="@style/CardText"
                android:text="@string/sync_keys_hint" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/context_title" />

            <TextView
                style="@style/CardText"
                android:text="@string/context_text" />

            <TextView
                android:id="@+id/geminiNote"
                style="@style/CardText"
                android:text="@string/gemini_note"
                android:textColor="@color/faint"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/prompt"
                style="@style/Field"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences" />

            <TextView
                android:id="@+id/languagesTitle"
                style="@style/CardTitle"
                android:layout_marginTop="16dp"
                android:text="@string/languages_title" />

            <TextView
                android:id="@+id/languagesText"
                style="@style/CardText"
                android:text="@string/languages_text" />

            <EditText
                android:id="@+id/languages"
                style="@style/Field"
                android:importantForAutofill="no"
                android:inputType="text"
                android:singleLine="true" />

            <TextView
                style="@style/CardTitle"
                android:layout_marginTop="16dp"
                android:text="@string/terms_title" />

            <TextView
                style="@style/CardText"
                android:text="@string/terms_text" />

            <EditText
                android:id="@+id/keywords"
                style="@style/Field"
                android:importantForAutofill="no"
                android:inputType="textMultiLine" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <Switch
                android:id="@+id/smart"
                style="@style/Toggle"
                android:text="@string/smart" />

            <TextView
                android:id="@+id/smartHint"
                style="@style/CardText"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="8dp"
                android:text="@string/smart_hint" />

            <Switch
                android:id="@+id/formatText"
                style="@style/Toggle"
                android:text="@string/format_text" />

            <Switch
                android:id="@+id/stopPhrase"
                style="@style/Toggle"
                android:text="@string/stop_phrase" />

            <Switch
                android:id="@+id/showCost"
                style="@style/Toggle"
                android:text="@string/show_cost" />

            <Switch
                android:id="@+id/autoPaste"
                style="@style/Toggle"
                android:text="@string/auto_paste" />

            <TextView
                style="@style/CardText"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="8dp"
                android:text="@string/auto_paste_hint" />

            <Switch
                android:id="@+id/restoreClipboard"
                style="@style/Toggle"
                android:text="@string/restore_clipboard" />

            <TextView
                style="@style/CardText"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="8dp"
                android:text="@string/restore_clipboard_hint" />

            <Switch
                android:id="@+id/telemetry"
                style="@style/Toggle"
                android:text="@string/telemetry" />

            <TextView
                style="@style/CardText"
                android:layout_marginTop="0dp"
                android:text="@string/telemetry_hint" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/paste_last" />

            <TextView
                style="@style/CardText"
                android:text="@string/paste_last_text" />
        </LinearLayout>

        <TextView
            style="@style/Section"
            android:text="@string/section_appearance" />

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/ui_language" />

            <RadioGroup
                android:id="@+id/uiLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/languageSystem"
                    style="@style/Toggle"
                    android:text="@string/system_default" />

                <RadioButton
                    android:id="@+id/languageRu"
                    style="@style/Toggle"
                    android:text="Русский" />

                <RadioButton
                    android:id="@+id/languageEn"
                    style="@style/Toggle"
                    android:text="English" />
            </RadioGroup>

            <TextView
                style="@style/CardTitle"
                android:layout_marginTop="16dp"
                android:text="@string/theme" />

            <RadioGroup
                android:id="@+id/theme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/themeSystem"
                    style="@style/Toggle"
                    android:text="@string/theme_system" />

                <RadioButton
                    android:id="@+id/themeLight"
                    style="@style/Toggle"
                    android:text="@string/theme_light" />

                <RadioButton
                    android:id="@+id/themeDark"
                    style="@style/Toggle"
                    android:text="@string/theme_dark" />
            </RadioGroup>
        </LinearLayout>

        <TextView
            style="@style/Section"
            android:text="@string/section_developer" />

        <LinearLayout style="@style/Card">

            <Switch
                android:id="@+id/showDelay"
                style="@style/Toggle"
                android:text="@string/show_delay" />

            <TextView
                style="@style/CardText"
                android:layout_marginTop="0dp"
                android:text="@string/show_delay_hint" />

            <RadioGroup
                android:id="@+id/delay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>

        <TextView
            android:id="@+id/version"
            style="@style/CardText"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textColor="@color/faint"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/updateStatus"
            style="@style/CardText"
            android:gravity="center"
            android:textColor="@color/faint"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/checkButton"
            style="@style/Action"
            android:layout_gravity="center_horizontal"
            android:paddingStart="12dp"
            android:text="@string/update_check" />
    </LinearLayout>
</ScrollView>
