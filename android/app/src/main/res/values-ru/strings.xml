    <string name="proxy_save">Сохранить</string>
    <string name="proxy_check">Проверить</string>
    <string name="proxy_none">Прокси нет: запросы идут напрямую.</string>
    <string name="proxy_via">Прокси включён: %1$s.</string>
    <string name="proxy_invalid">Не похоже на адрес прокси: нужно http://логин:пароль@адрес:порт.</string>
    <string name="proxy_saved">Прокси сохранён.</string>
