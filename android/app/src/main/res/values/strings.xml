    <string name="setup_a11y_title">Ciao button</string>
    <string name="setup_a11y_text">Turn on the “Ciao dictation” service: it shows the button above the keyboard and puts the text in. Ciao reads only the field you type in.</string>
    <string name="setup_a11y_open">Open settings</string>
    <string name="setup_a11y_off">Off</string>
    <string name="setup_a11y_done">Running</string>
    <string name="setup_a11y_search">Can’t find it? Search the settings for “Accessibility”.</string>
    <string name="setup_a11y_stopped">On, but not running</string>
    <string name="setup_a11y_stopped_text">The phone stopped Ciao and left the switch on. Turn “Ciao dictation” off and on again.</string>
    <string name="setup_a11y_stopped_then">To keep it from happening again, let Ciao run in the background (next step).</string>
    <string name="setup_a11y_reopen">Open and turn it on again</string>
    <string name="setup_restricted_title">Is the switch grey or won’t turn on?</string>
    <string name="setup_restricted_1">Tap “App info” below.</string>
    <string name="setup_restricted_2">Tap ⋮ in the top corner and choose “Allow restricted settings”.</string>
    <string name="setup_restricted_3">Come back and open the settings again.</string>
    <string name="path_a11y_generic_1">Open “Downloaded apps” (or “Installed services”).</string>
    <string name="path_a11y_generic_2">Choose “Ciao dictation” and turn it on.</string>
    <string name="path_a11y_generic_3">Confirm in the warning.</string>
    <string name="path_a11y_huawei_1">Open “Installed services” at the bottom of the list.</string>
    <string name="path_a11y_huawei_2">Choose “Ciao dictation”, turn it on and tap “OK”.</string>
    <string name="path_a11y_huawei_note">By hand: Settings → Accessibility features → Installed services.</string>
    <string name="path_a11y_xiaomi_1">Open “Downloaded apps”.</string>
    <string name="path_a11y_xiaomi_2">Choose “Ciao dictation” and turn it on.</string>
    <string name="path_a11y_xiaomi_3">Wait until “OK” in the warning becomes active (10 seconds).</string>
    <string name="path_a11y_xiaomi_note">By hand: Settings → Additional settings → Accessibility.</string>
    <string name="path_a11y_samsung_1">Open “Installed apps”.</string>
    <string name="path_a11y_samsung_2">Choose “Ciao dictation”, turn it on and tap “Allow”.</string>
    <string name="setup_bg_title">Running in the background</string>
    <string name="setup_bg_text">This phone closes apps by itself, and the Ciao button disappears. Let Ciao run in the background.</string>
    <string name="setup_bg_open">Open settings</string>
    <string name="setup_bg_confirm">Done</string>
    <string name="setup_bg_done">Marked by you</string>
    <string name="setup_bg_not_yet">Not set</string>
    <string name="setup_bg_battery">The phone closes Ciao less often when it doesn’t save battery on it.</string>
    <string name="setup_bg_battery_allow">Don’t save battery on Ciao</string>
    <string name="setup_bg_battery_done">No battery saving for Ciao</string>
    <string name="path_bg_huawei_1">Find Ciao in the “App launch” list and turn its switch off: the “Manage manually” window opens.</string>
    <string name="path_bg_huawei_2">In “Manage manually” keep all three on: auto-launch, secondary launch, run in background.</string>
    <string name="path_bg_huawei_3">Tap “OK” and come back here.</string>
    <string name="path_bg_huawei_note">By hand: Settings → Battery → App launch.</string>
    <string name="path_bg_xiaomi_1">Turn Ciao on in the “Autostart” list.</string>
    <string name="path_bg_xiaomi_2">Then: Settings → Apps → Ciao → “Battery saver” → “No restrictions”.</string>
    <string name="path_bg_xiaomi_note">By hand: Settings → Apps → Permissions → Autostart.</string>
    <string name="hint_recents_huawei">And lock Ciao in the recent apps: pull its card down.</string>
    <string name="hint_recents_xiaomi">And lock Ciao in the recent apps: hold its card and tap the lock.</string>
