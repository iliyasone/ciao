<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name" translatable="false">Ciao</string>
    <string name="tagline">See what you say while you say it.</string>
    <string name="service_label">Ciao dictation</string>
    <string name="service_description">Shows the Ciao button while the keyboard is open, and types what you dictate into the text field. Ciao only looks at which field has focus and its text, and never sends it anywhere.</string>
    <string name="bubble_description">Dictate with Ciao</string>

    <string name="section_setup">Setup</string>
    <string name="provider_title">Service</string>
    <string name="provider_text">Who turns your speech into text. You pay them directly with your own API key.</string>
    <string name="provider_openai" translatable="false">OpenAI</string>
    <string name="provider_gemini" translatable="false">Google Gemini</string>
    <string name="key_title">%1$s API key</string>
    <string name="key_text_openai">Needs access to gpt-live-transcribe. Live dictation costs $0.017 per minute of speech; idle time is free. The key stays on this phone.</string>
    <string name="key_text_gemini">Get one at aistudio.google.com/apikey. Live dictation with gemini-3.5-transcribe-live costs about $0.009 per minute of speech; idle time is free. The key stays on this phone.</string>
    <string name="key_hint_openai" translatable="false">sk-…</string>
    <string name="key_hint_gemini" translatable="false">AQ.…</string>
    <string name="mic_title">Microphone</string>
    <string name="mic_text">Recording starts only when you tap the Ciao button and stops when you finish.</string>
    <string name="mic_allow">Allow microphone</string>
    <string name="a11y_title">Ciao button over the keyboard</string>
    <string name="a11y_text">Turn on “Ciao dictation” in Accessibility. Ciao uses it to see when the keyboard is open and to type the text into the field.</string>
    <string name="a11y_open">Open Accessibility settings</string>
    <string name="a11y_open_again">Accessibility settings</string>
    <string name="a11y_restricted">Switch greyed out? Android blocks this for apps installed from a file: open App info, tap ⋮ in the corner, choose “Allow restricted settings”, then come back.</string>
    <string name="app_info">App info</string>
    <string name="try_title">Try it</string>
    <string name="try_text">Tap the field below, then tap the Ciao button above the keyboard and speak. Tap it again or say “ciao ciao” to finish. Hold it to talk while held. Drag it to move it.</string>
    <string name="try_hint">Tap here and dictate…</string>

    <string name="section_recognition">Recognition</string>
    <string name="sync_title">Sync with Google</string>
    <string name="sync_text">Sign in to use the same terms, context and API key on all your devices. They\'re kept in a hidden Ciao folder in your Google Drive; Ciao can\'t see any other file there.</string>
    <string name="sync_sign_in">Sign in with Google</string>
    <string name="sync_keys">Sync API keys</string>
    <string name="sync_keys_hint">Easier: on a new device you just sign in, no key to paste. The keys sit in the hidden Ciao folder in your Google Drive, so anyone who can sign in to your Google account can read them. Turn this off to keep each key on its own device only: Ciao removes them from Drive.</string>
    <string name="sync_sign_out">Sign out</string>
    <string name="sync_signing_in">Signing in…</string>
    <string name="sync_syncing">%1$s · syncing…</string>
    <string name="sync_synced">%1$s · synced at %2$s</string>
    <string name="sync_sign_in_failed">Couldn\'t sign in: %1$s</string>
    <string name="sync_failed">Couldn\'t sync: %1$s</string>
    <string name="sync_signed_out">Google no longer gives Ciao access. Sign in again</string>
    <string name="sync_newer_format">The sync file was written by a newer Ciao. Update the app</string>
    <string name="sync_no_drive">no access to Drive. Sign in again and tick the box about configuration data in your Google Drive</string>
    <string name="context_title">Context</string>
    <string name="context_text">What you usually talk about. Helps the recognizer with names and terms.</string>
    <string name="gemini_note">Gemini detects the language itself and takes no context, only the terms.</string>
    <string name="terms_title">Terms</string>
    <string name="terms_text">Words that must be spelled exactly, one per line.</string>
    <string name="format_text">Paragraphs and lists</string>
    <string name="stop_phrase">Say “ciao ciao” to finish</string>
    <string name="show_cost">Show the cost of a dictation</string>
    <string name="smart">Apply spoken corrections</string>
    <string name="smart_hint">Drops “um”, false starts and repeats, and applies corrections: “at 2, no, at 3” becomes “at 3”. In the final text only: while you speak you see everything as said.</string>
