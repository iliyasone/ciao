{
  "name": "ciao",
  "productName": "Ciao",
  "version": "0.8.4",
  "description": "Dictation with a live preview: see what you say while you say it.",
  "homepage": "https://sayciao.vercel.app",
  "private": true,
  "main": "dist/main/main.js",
  "author": "Ilias Dzhabbarov",
  "license": "MIT",
  "scripts": {
    "build:native": "dotnet publish native/win-input -c Release -r win-x64 --self-contained false -p:PublishSingleFile=true -o build/win-input",
    "build:native:mac": "sh scripts/build-mac-input.sh",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc --noEmit -p .",
    "dist:win": "npm run build && electron-builder --win dir",
    "dist:win:installer": "npm run build && electron-builder --win nsis --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "release": "npm run build && electron-builder --win nsis --publish always",
    "release:linux": "npm run build && electron-builder --linux AppImage deb --publish always",
    "release:mac": "npm run build && electron-builder --mac --publish always",
    "build:kws": "node scripts/fetch-kws.mjs",
    "build:kws:linux": "node scripts/fetch-kws.mjs linux"
  },
  "build": {
    "appId": "dev.iliyasone.ciao",
    "productName": "Ciao",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "*.png",
          "*.ico"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "extraResources": [
        {
          "from": "build/win-input",
          "to": "win-input",
          "filter": [
            "*.exe"
          ]
        },
        {
          "from": "build/kws",
          "to": "kws"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Ciao-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "synopsis": "Dictation with a live preview",
      "executableName": "ciao",
      "maintainer": "Ilias Dzhabbarov <iliyasone@users.noreply.github.com>",
      "extraResources": [
        {
          "from": "build/kws",
          "to": "kws"
        }
      ]
    },
    "appImage": {
      "artifactName": "Ciao-${version}.AppImage"
    },
    "deb": {
      "artifactName": "Ciao-${version}.deb"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "13.0",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "Ciao records your voice while you dictate."
      },
      "extraResources": [
        {
          "from": "build/mac-input",
          "to": "mac-input",
          "filter": [
            "Ciao.Input"
          ]
        }
      ],
      "electronLanguages": [
        "en",
        "ru"
      ]
    },
    "dmg": {
      "artifactName": "Ciao-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "iliyasone",
        "repo": "ciao",
        "releaseType": "draft"
      }
    ],
    "asar": true,
    "electronLanguages": [
      "en-US",
      "ru"
    ]
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "adm-zip": "^0.5.18",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "ws": "^8.22.0"
  }
}
